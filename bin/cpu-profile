#!/usr/bin/env bash

# Total possible logical threads present in hardware/sysfs
total_possible=$(ls -d /sys/devices/system/cpu/cpu[0-9]* | wc -l)
threads_per_core=$(lscpu | grep "Thread(s) per core:" | awk '{print $NF}')
[ -z "$threads_per_core" ] && threads_per_core=1
max_phys=$(( total_possible / threads_per_core ))

get_max_hardware_freq() {
    local mf
    mf=$(cat /sys/devices/system/cpu/cpu0/cpufreq/cpuinfo_max_freq 2>/dev/null)
    [ -z "$mf" ] && mf=3800000
    echo "$mf"
}

get_min_hardware_freq() {
    local mf
    mf=$(cat /sys/devices/system/cpu/cpu0/cpufreq/cpuinfo_min_freq 2>/dev/null)
    [ -z "$mf" ] && mf=1200000
    echo "$mf"
}

get_base_hardware_freq() {
    # 1. Sysfs base_frequency
    if [ -f /sys/devices/system/cpu/cpu0/cpufreq/base_frequency ]; then
        cat /sys/devices/system/cpu/cpu0/cpufreq/base_frequency
        return
    fi
    # 2. Parse "@ X.XXGHz" from CPU model name
    local ghz
    ghz=$(lscpu | grep "Model name:" | grep -oP "@\s*\K[0-9.]+(?=GHz)" | tr -d " ")
    if [ -n "$ghz" ]; then
        awk -v g="$ghz" 'BEGIN {printf "%.0f", g * 1000000}'
        return
    fi
    # 3. Fallback to 70% of max freq
    local maxf
    maxf=$(get_max_hardware_freq)
    awk -v m="$maxf" 'BEGIN {printf "%.0f", m * 0.65}'
}

set_turbo() {
    local enable="$1"
    if [ "$enable" = "1" ]; then
        # Intel
        [ -f /sys/devices/system/cpu/intel_pstate/no_turbo ] && echo 0 | sudo tee /sys/devices/system/cpu/intel_pstate/no_turbo > /dev/null 2>&1
        # AMD
        [ -f /sys/devices/system/cpu/cpufreq/boost ] && echo 1 | sudo tee /sys/devices/system/cpu/cpufreq/boost > /dev/null 2>&1
    else
        # Intel
        [ -f /sys/devices/system/cpu/intel_pstate/no_turbo ] && echo 1 | sudo tee /sys/devices/system/cpu/intel_pstate/no_turbo > /dev/null 2>&1
        # AMD
        [ -f /sys/devices/system/cpu/cpufreq/boost ] && echo 0 | sudo tee /sys/devices/system/cpu/cpufreq/boost > /dev/null 2>&1
    fi
}

get_split_masks() {
    local target_fast="$1"
    local online_phys=()
    local temp_list=()
    for cpu_dir in /sys/devices/system/cpu/cpu[0-9]*; do
        local is_online="1"
        [ -f "$cpu_dir/online" ] && is_online=$(cat "$cpu_dir/online" 2>/dev/null)
        if [ "$is_online" = "1" ]; then
            local p=$(cat "$cpu_dir/topology/core_id" 2>/dev/null)
            [ -n "$p" ] && temp_list+=("$p")
        fi
    done
    online_phys=($(printf '%s\n' "${temp_list[@]}" | sort -n -u))
    local total_online_phys=${#online_phys[@]}

    [ -z "$target_fast" ] && target_fast=$(( total_online_phys / 2 ))
    [ "$target_fast" -ge "$total_online_phys" ] && target_fast=$(( total_online_phys - 1 ))
    [ "$target_fast" -le 0 ] && target_fast=1

    local fast_list=()
    local eco_list=()

    # Find CPUs belonging to fast physical cores
    for ((idx=0; idx<target_fast; idx++)); do
        local pcore="${online_phys[$idx]}"
        for cpu_dir in /sys/devices/system/cpu/cpu[0-9]*; do
            local is_online="1"
            [ -f "$cpu_dir/online" ] && is_online=$(cat "$cpu_dir/online" 2>/dev/null)
            if [ "$is_online" = "1" ]; then
                local p=$(cat "$cpu_dir/topology/core_id" 2>/dev/null)
                if [ "$p" = "$pcore" ]; then
                    local cnum=$(basename "$cpu_dir" | sed 's/cpu//')
                    fast_list+=("$cnum")
                fi
            fi
        done
    done

    # Find CPUs belonging to eco physical cores
    for ((idx=target_fast; idx<total_online_phys; idx++)); do
        local pcore="${online_phys[$idx]}"
        for cpu_dir in /sys/devices/system/cpu/cpu[0-9]*; do
            local is_online="1"
            [ -f "$cpu_dir/online" ] && is_online=$(cat "$cpu_dir/online" 2>/dev/null)
            if [ "$is_online" = "1" ]; then
                local p=$(cat "$cpu_dir/topology/core_id" 2>/dev/null)
                if [ "$p" = "$pcore" ]; then
                    local cnum=$(basename "$cpu_dir" | sed 's/cpu//')
                    eco_list+=("$cnum")
                fi
            fi
        done
    done

    FAST_MASK=$(printf '%s\n' "${fast_list[@]}" | sort -n -u | paste -sd, -)
    ECO_MASK=$(printf '%s\n' "${eco_list[@]}" | sort -n -u | paste -sd, -)
    FAST_PHYS_COUNT="$target_fast"
    ECO_PHYS_COUNT=$(( total_online_phys - target_fast ))
}

show_status() {
    local online_count=$(nproc)
    local smt_state=$(cat /sys/devices/system/cpu/smt/control 2>/dev/null)
    [ -z "$smt_state" ] && smt_state="n/a"
    echo "Current CPU Status: $online_count Threads Online (Out of $total_possible) | SMT/HT: $smt_state"
    for ((i=0; i<total_possible; i++)); do
        local is_online="1"
        [ -f "/sys/devices/system/cpu/cpu$i/online" ] && is_online=$(cat "/sys/devices/system/cpu/cpu$i/online" 2>/dev/null)
        local phys=$(cat "/sys/devices/system/cpu/cpu$i/topology/core_id" 2>/dev/null)
        [ -z "$phys" ] && phys="--"
        
        if [ "$is_online" = "0" ]; then
            printf "CPU %-2d (Core %-2s)  %-10s  %-15s  %s\n" "$i" "$phys" "[OFFLINE]" "(Power-Gated)" "0 MHz (0W Sleep)"
        else
            local gov=$(cat "/sys/devices/system/cpu/cpu$i/cpufreq/scaling_governor" 2>/dev/null)
            local freq=$(awk '{printf "%.0f MHz", $1/1000}' "/sys/devices/system/cpu/cpu$i/cpufreq/scaling_cur_freq" 2>/dev/null)
            local maxf=$(awk '{printf "%.1f GHz", $1/1000000}' "/sys/devices/system/cpu/cpu$i/cpufreq/scaling_max_freq" 2>/dev/null)
            printf "CPU %-2d (Core %-2s)  %-10s  (Max: %-7s)  %s\n" "$i" "$phys" "$gov" "$maxf" "$freq"
        fi
    done

    # ponytail: notify user if CoreCtrl is running to prevent silent override confusion
    if pgrep -x corectrl >/dev/null 2>&1; then
        echo "⚠️  Note: CoreCtrl is running. Ensure CPU control is disabled in CoreCtrl to avoid overrides."
    fi
}

set_active_cores() {
    local target="$1"
    
    if [ "$target" = "all" ] || [ "$target" -ge "$max_phys" ] 2>/dev/null; then
        echo "Bringing ALL $max_phys physical cores online..."
        for g in /sys/devices/system/cpu/cpu*/online; do
            echo 1 | sudo tee "$g" > /dev/null 2>&1
        done
        show_status
        return 0
    fi
    
    if [ "$target" -lt 1 ] 2>/dev/null; then
        echo "Usage: cpu-profile cores [1-$max_phys|all]"
        return 1
    fi
    
    echo "Setting active physical cores to $target (power-gating $((max_phys - target)) physical cores to 0W)..."
    
    # Enable target cores
    for ((c=0; c<target; c++)); do
        for sib in $(cat "/sys/devices/system/cpu/cpu$c/topology/thread_siblings_list" 2>/dev/null | tr "," " "); do
            [ -f "/sys/devices/system/cpu/cpu$sib/online" ] && echo 1 | sudo tee "/sys/devices/system/cpu/cpu$sib/online" > /dev/null 2>&1
        done
    done
    
    # Offline remaining cores
    for ((c=target; c<max_phys; c++)); do
        for sib in $(cat "/sys/devices/system/cpu/cpu$c/topology/thread_siblings_list" 2>/dev/null | tr "," " "); do
            [ -f "/sys/devices/system/cpu/cpu$sib/online" ] && echo 0 | sudo tee "/sys/devices/system/cpu/cpu$sib/online" > /dev/null 2>&1
        done
    done
    
    show_status
}

set_ht() {
    local state="$1"
    case "$state" in
        on|enable|enabled)
            echo "Enabling Hyperthreading / SMT..."
            echo on | sudo tee /sys/devices/system/cpu/smt/control > /dev/null 2>&1
            show_status
            ;;
        off|disable|disabled)
            echo "Disabling Hyperthreading / SMT..."
            echo off | sudo tee /sys/devices/system/cpu/smt/control > /dev/null 2>&1
            show_status
            ;;
        *)
            echo "Usage: cpu-profile ht [on|off]"
            ;;
    esac
}

find_game_pids() {
    local target="$1"
    if [ -n "$target" ]; then
        if [[ "$target" =~ ^[0-9]+$ ]]; then
            echo "$target"
        else
            pgrep -fi "$target"
        fi
    else
        # Auto-detect running game .exe and wineserver (excluding windows system services)
        pgrep -f '\.exe' | while read -r p; do
            comm=$(ps -p "$p" -o comm= 2>/dev/null)
            if [[ ! "$comm" =~ (services|svchost|rpcss|plugplay|explorer|winedevice|tabtip|conhost|rtk|bash|python) ]]; then
                echo "$p"
            fi
        done
        pgrep -x wineserver
    fi
}

pin_processes() {
    local mode="$1"
    local target="$2"
    local cores=""
    local mode_label=""

    get_split_masks

    case "$mode" in
        eco)
            cores="$ECO_MASK"
            mode_label="Eco Cores ($cores @ powersave)"
            ;;
        fast|perf|performance)
            cores="$FAST_MASK"
            mode_label="Fast Cores ($cores @ schedutil)"
            ;;
        all|unpin)
            cores=$(cat /sys/devices/system/cpu/online 2>/dev/null)
            mode_label="All Online Cores ($cores)"
            ;;
        *)
            echo "Usage: $(basename "$0") [eco|fast|all] [process_name|PID]"
            return 1
            ;;
    esac

    local pids
    pids=$(find_game_pids "$target" | sort -u)

    if [ -z "$pids" ]; then
        echo "No running game or matching process found."
        return 1
    fi

    echo "Moving all threads to $mode_label:"
    for p in $pids; do
        if [ -d "/proc/$p" ] && [ "$p" != "$$" ] && [ "$p" != "$PPID" ]; then
            comm=$(ps -p "$p" -o comm= 2>/dev/null)
            taskset -a -pc "$cores" "$p" > /dev/null 2>&1
            echo "  ✓ PID $p ($comm): all threads pinned to $cores"
        fi
    done
}

# If invoked directly as 'game-pin'
if [ "$(basename "$0")" = "game-pin" ]; then
    pin_processes "$1" "$2"
    exit $?
fi

hw_max=$(get_max_hardware_freq)
hw_min=$(get_min_hardware_freq)
hw_base=$(get_base_hardware_freq)

case "$1" in
    cores|core)
        set_active_cores "$2"
        ;;
    ht|smt)
        set_ht "$2"
        ;;
    eco)
        set_turbo 0
        for ((i=0; i<total_possible; i++)); do
            if [ -d "/sys/devices/system/cpu/cpu$i/cpufreq" ]; then
                echo "$hw_max" | sudo tee "/sys/devices/system/cpu/cpu$i/cpufreq/scaling_max_freq" > /dev/null
                echo powersave | sudo tee "/sys/devices/system/cpu/cpu$i/cpufreq/scaling_governor" > /dev/null
            fi
        done
        min_ghz=$(awk -v m="$hw_min" 'BEGIN {printf "%.1f GHz", m/1000000}')
        echo "CPU Mode: Full Eco (All online threads @ $min_ghz locked)"
        show_status
        ;;
    base|noboost|chill|2.3)
        # Custom or auto-detected base frequency
        target_base="$hw_base"
        if [ -n "$2" ] && [[ "$2" =~ ^[0-9.]+$ ]]; then
            target_base=$(awk -v g="$2" 'BEGIN {printf "%.0f", g * 1000000}')
        fi
        base_ghz=$(awk -v b="$target_base" 'BEGIN {printf "%.1f GHz", b/1000000}')
        
        set_turbo 0
        for ((i=0; i<total_possible; i++)); do
            if [ -d "/sys/devices/system/cpu/cpu$i/cpufreq" ]; then
                echo "$target_base" | sudo tee "/sys/devices/system/cpu/cpu$i/cpufreq/scaling_max_freq" > /dev/null
                echo schedutil | sudo tee "/sys/devices/system/cpu/cpu$i/cpufreq/scaling_governor" > /dev/null
            fi
        done
        echo "CPU Mode: Base / No Boost (All online threads on Schedutil capped @ $base_ghz, 0% Turbo)"
        show_status
        ;;
    split)
        set_turbo 1
        
        split_count=""
        split_gov="schedutil"
        split_label="Schedutil"
        
        for arg in "$2" "$3"; do
            if [[ "$arg" =~ ^[0-9]+$ ]]; then
                split_count="$arg"
            elif [[ "$arg" =~ ^(max|perf|performance)$ ]]; then
                split_gov="performance"
                split_label="Performance (Locked)"
            elif [[ "$arg" =~ ^(fast|schedutil)$ ]]; then
                split_gov="schedutil"
                split_label="Schedutil"
            fi
        done
        
        get_split_masks "$split_count"
        
        IFS=',' read -r -a fast_cpus <<< "$FAST_MASK"
        for c in "${fast_cpus[@]}"; do
            echo "$hw_max" | sudo tee "/sys/devices/system/cpu/cpu$c/cpufreq/scaling_max_freq" > /dev/null
            echo "$split_gov" | sudo tee "/sys/devices/system/cpu/cpu$c/cpufreq/scaling_governor" > /dev/null
        done
        
        IFS=',' read -r -a eco_cpus <<< "$ECO_MASK"
        for c in "${eco_cpus[@]}"; do
            echo "$hw_max" | sudo tee "/sys/devices/system/cpu/cpu$c/cpufreq/scaling_max_freq" > /dev/null
            echo powersave | sudo tee "/sys/devices/system/cpu/cpu$c/cpufreq/scaling_governor" > /dev/null
        done
        
        echo "CPU Mode: Split ($FAST_PHYS_COUNT Physical Cores @ $split_label, $ECO_PHYS_COUNT Physical Cores @ Powersave)"
        show_status
        ;;
    max|perf|performance)
        set_turbo 1
        for ((i=0; i<total_possible; i++)); do
            if [ -d "/sys/devices/system/cpu/cpu$i/cpufreq" ]; then
                echo "$hw_max" | sudo tee "/sys/devices/system/cpu/cpu$i/cpufreq/scaling_max_freq" > /dev/null
                echo performance | sudo tee "/sys/devices/system/cpu/cpu$i/cpufreq/scaling_governor" > /dev/null
            fi
        done
        max_ghz=$(awk -v m="$hw_max" 'BEGIN {printf "%.1f GHz", m/1000000}')
        echo "CPU Mode: Maximum Performance (All online threads locked to performance governor @ $max_ghz)"
        show_status
        ;;
    fast)
        set_turbo 1
        for ((i=0; i<total_possible; i++)); do
            if [ -d "/sys/devices/system/cpu/cpu$i/cpufreq" ]; then
                echo "$hw_max" | sudo tee "/sys/devices/system/cpu/cpu$i/cpufreq/scaling_max_freq" > /dev/null
                echo schedutil | sudo tee "/sys/devices/system/cpu/cpu$i/cpufreq/scaling_governor" > /dev/null
            fi
        done
        max_ghz=$(awk -v m="$hw_max" 'BEGIN {printf "%.1f GHz", m/1000000}')
        echo "CPU Mode: Full Performance (All online threads on Schedutil up to $max_ghz Turbo)"
        show_status
        ;;
    pin)
        pin_processes "$2" "$3"
        ;;
    status)
        show_status
        ;;
    uninstall)
        # ponytail: direct self-uninstall, no extra scripts needed
        echo "Uninstalling cpu-profile and game-pin from ${HOME}/.local/bin..."
        rm -f "${HOME}/.local/bin/cpu-profile" "${HOME}/.local/bin/game-pin"
        echo "Uninstalled successfully."
        exit 0
        ;;
    *)
        echo "Usage: cpu-profile [cores <N|all>|ht <on|off>|max|fast|base [GHz]|eco|split [N] [mode]|status|pin [eco|fast|all]|uninstall]"
        echo ""
        echo "Hardware Control (No Reboot Needed!):"
        echo "  cpu-profile cores <N>     : Sets active physical cores to N (1-$max_phys), power-gates rest to 0W"
        echo "  cpu-profile cores all     : Restores all $max_phys physical cores online"
        echo "  cpu-profile ht [on|off]   : Toggles Hyperthreading / SMT on the fly"
        echo ""
        echo "Governor Profiles:"
        echo "  cpu-profile max           : All online threads on Performance governor (Locked max Turbo clock)"
        echo "  cpu-profile fast          : All online threads on Schedutil (Dynamic Turbo Boost)"
        echo "  cpu-profile base [GHz]    : All online threads on Schedutil capped at base clock (No Boost, cool & quiet)"
        echo "  cpu-profile eco           : All online threads on Powersave (minimum clock locked, lowest power)"
        echo "  cpu-profile split [N] [mode] : N Primary Cores (mode: max|fast) + remaining Eco Cores"
        echo "  cpu-profile status        : Show current core online/offline status, max cap, and live MHz"
        echo ""
        echo "Instant Thread Pinning (Auto-detects Game, No Sudo Needed!):"
        echo "  game-pin fast             : Moves ALL threads of the game to Fast Cores"
        echo "  game-pin eco              : Moves ALL threads of the game to Eco Cores"
        echo "  game-pin all              : Unpins game back to all online threads"
        echo ""
        echo "Maintenance:"
        echo "  cpu-profile uninstall     : Removes cpu-profile and game-pin from ~/.local/bin"
        ;;
esac
